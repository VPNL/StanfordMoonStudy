visual angles for both rounds using respective arm lengths\n","\n","# Creates the lookup table for moon sizes from Base Fact.xlsx\n","moon_sizes <- data.frame(Moon = 1:20, Size = c(0.30, 0.39, 0.49, 0.52, 0.65, 0.72, 0.78, 0.96, 0.98, 1.22,\n","                                               1.44, 1.63, 1.90, 2.15, 2.44, 2.70, 3.30, 3.80, 4.00, 4.70))\n","\n","# Map moon sizes to Perceptual and final moons for both rounds and assign altitudes\n","data <- data %>%\n","  mutate(\n","    Lower_Elevation_Perceptual = moon_sizes$Size[match(data[, 2], moon_sizes$Moon)],\n","    Lower_Elevation_Adjusted = moon_sizes$Size[match(data[, 5], moon_sizes$Moon)],\n","    Higher_Elevation_Perceptual = moon_sizes$Size[match(data[, 12], moon_sizes$Moon)],\n","    Higher_Elevation_Adjusted = moon_sizes$Size[match(data[, 15], moon_sizes$Moon)],\n","\n","    Lower_Altitude = data[, 8],\n","    Higher_Altitude = data[, 18],\n","\n","    Lower_Elevation_Perceptual_VA = 2 * atan(Lower_Elevation_Perceptual / (2 * data[, 3])) * (180 / pi),\n","    Lower_Elevation_Adjusted_VA = 2 * atan(Lower_Elevation_Adjusted / (2 * data[, 6])) * (180 / pi),\n","    Higher_Elevation_Perceptual_VA = 2 * atan(Higher_Elevation_Perceptual / (2 * data[, 13])) * (180 / pi),\n","    Higher_Elevation_Adjusted_VA = 2 * atan(Higher_Elevation_Adjusted / (2 * data[, 16])) * (180 / pi),\n","\n","    Lower_Disparity_VA = 2 * atan(Lower.Elevation.Disparity.cm. / (2 * Lower.Elevation.Disparity.Arm.Length..cm.)) * (180 / pi),\n","    Higher_Disparity_VA = 2 * atan(Higher.Elevation.Disparity..cm./ (2 * Higher.Elevation.Disparity.Arm.Length..cm.)) * (180 / pi),\n","\n","    Real_Visual_Angle = case_when(\n","      row_number() %in% 1:12 ~ 0.5037,\n","      row_number() %in% 13:18 ~ 0.5316,\n","      row_number() %in% 19:22 ~ 0.5377,\n","      row_number() %in% 23:25 ~ 0.5482,\n","      row_number() %in% 26:36 ~ 0.5518,\n","      row_number() %in% 37:54 ~ 0.5484,\n","      row_number() %in% 55:83 ~ 0.5423,\n","      row_number() %in% 84:103 ~ 0.4761,\n","      row_number() %in% 104:130 ~ 0.5251,\n","      row_number() %in% 131:148 ~ 0.5282\n","      ),\n","    Distance = case_when(\n","      row_number() %in% 1:12 ~ 395235.5743,\n","      row_number() %in% 13:18 ~ 374539.4104,\n","      row_number() %in% 19:22 ~ 370232.8059,\n","      row_number() %in% 23:25 ~ 363196.754,\n","      row_number() %in% 26:36 ~ 360803.6594,\n","      row_number() %in% 37:54 ~ 183560.6568,\n","      row_number() %in% 55:83 ~ 181518.8318,\n","      row_number() %in% 84:103 ~ 209084.4666,\n","      row_number() %in% 104:130 ~ 379146.9623,\n","      row_number() %in% 131:148 ~ 376953.40\n","      ),\n","    Date = case_when(\n","      row_number() %in% 1:12 ~ \"May 22\",\n","      row_number() %in% 13:18 ~ \"Jul 20\",\n","      row_number() %in% 19:22 ~ \"Jul 21\",\n","      row_number() %in% 23:25 ~ \"Aug 19\",\n","      row_number() %in% 26:36 ~ \"Aug 20\",\n","      row_number() %in% 37:54 ~ \"Oct 16\",\n","      row_number() %in% 55:83 ~ \"Oct 17\",\n","      row_number() %in% 84:103 ~ \"Nov 15th\",\n","      row_number() %in% 104:130 ~ \"Jan 12th\",\n","      row_number() %in% 131:148 ~ \"Jan 13th\"\n","      ),\n","    )\n","\n","data_long <- data %>%\n","  pivot_longer(\n","    cols = c(Lower_Elevation_Perceptual_VA, Lower_Elevation_Adjusted_VA,\n","             Higher_Elevation_Perceptual_VA, Higher_Elevation_Adjusted_VA),\n","    names_to = \"Measurement_Type\",\n","    values_to = \"Reported_Visual_Angle\"\n","  ) %>%\n","  mutate(\n","    Task = case_when(\n","      grepl(\"Perceptual\", Measurement_Type) ~ \"Perceptual\",\n","      grepl(\"Adjusted\", Measurement_Type) ~ \"Adjusted\"\n","    ),\n","    Altitude = case_when(\n","      grepl(\"Lower_Elevation\", Measurement_Type) ~ Lower_Altitude,\n","      grepl(\"Higher_Elevation\", Measurement_Type) ~ Higher_Altitude\n","    ),\n","    Session = case_when(\n","      grepl(\"Lower\", Measurement_Type) ~ \"Lower\",\n","      grepl(\"Higher\", Measurement_Type) ~ \"Higher\"\n","    ),\n","    # Calculate Disparity_VA using the pre-calculated columns\n","    Disparity_VA = case_when(\n","      Session == \"Lower\" ~ Lower_Disparity_VA,\n","      Session == \"Higher\" ~ Higher_Disparity_VA\n","    )\n","  )\n","\n","# Convert ID and Task to factors, calculate ratio, and select relevant columns\n","data_long <- data_long %>%\n","  mutate(\n","    ID = factor(ID.Number),\n","    Task = factor(Task),\n","    #calculates the perceived/groundtruth ratio\n","    Ratio_Visual_Angle = Reported_Visual_Angle / Real_Visual_Angle,\n","  ) %>%\n","  select(ID, Session, Task, Altitude, Disparity_VA,Reported_Visual_Angle, Real_Visual_Angle, Ratio_Visual_Angle, Distance, Date)\n","\n","perceptual_data <- data_long%>%\n","  filter(Task == \"Perceptual\")\n","\n","adjusted_data <- data_long %>%\n","  filter(Task == \"Adjusted\")\n","\n","# Different Print commands for debugging and visualizing data_long\n","# print(Disparity_VA)\n","# print(data_long %>% select(Ratio_Visual_Angle, Distance), n = nrow(data_long))\n","# print(data_long, n = nrow(data_long))\n","write.csv(data_long, file = \"fullmoon_data_longer.csv\", row.names = FALSE)"]},{"cell_type":"markdown","metadata":{"id":"szQOgVXaQHL0"},"source":["\n","Only excecute this next cell if you want outliers to be removed; otherwise skip and execute the cell after ths."]},{"cell_type":"code","execution_count":null,"metadata":{"id":"KOZvCrBUTyUt","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1745962398109,"user_tz":420,"elapsed":89,"user":{"displayName":"Keithan Ducre","userId":"01311834719829791810"}},"outputId":"17603fdb-8bf1-4f5c-ac7e-fd9c595bb91b"},"outputs":[{"output_type":"stream","name":"stdout","text":["[1] \"Data with Z-scores and Outliers Flagged:\"\n","\u001b[90m# A tibble: 592 × 12\u001b[39m\n","   ID    Session Task       Altitude Disparity_VA Reported_Visual_Angle\n","   \u001b[3m\u001b[90m<fct>\u001b[39m\u001b[23m \u001b[3m\u