entire dataset\n","  data_with_z_scores <- data %>%\n","    mutate(z_score = (get(value_col) - mean(get(value_col), na.rm = TRUE)) / sd(get(value_col), na.rm = TRUE),\n","           is_outlier = abs(z_score) > 3)\n","\n","  # Print data with z-scores and outlier flags for debugging\n","  print(\"Data with Z-scores and Outliers Flagged:\")\n","  print(data_with_z_scores)\n","\n","  # Identify IDs with outliers\n","  ids_with_outliers <- data_with_z_scores %>%\n","    filter(is_outlier) %>%\n","    distinct(!!sym(id_col)) %>%\n","    pull(!!sym(id_col))\n","\n","  # Print IDs with outliers for debugging\n","  print(\"IDs with Outliers:\")\n","  print(ids_with_outliers)\n","\n","  # Remove all data points for IDs with outliers\n","  cleaned_data <- data %>%\n","    filter(!(get(id_col) %in% ids_with_outliers))\n","\n","  return(cleaned_data)\n","}\n","\n","data_long_no_outliers <- remove_participant_with_outliers(data_long, id_col = \"ID\", value_col = \"Reported_Visual_Angle\")\n","\n","# Verify the cleaned data\n","# print(data_long_no_outliers, n = nrow(data_long_no_outliers))\n","\n","\n"]},{"cell_type":"markdown","metadata":{"id":"7xb_lFoK7suz"},"source":["This starts the stastical tests, make sure to run all code cells above (sans the outlier cell) before you began any data visualization"]},{"cell_type":"code","execution_count":20,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":1664,"status":"ok","timestamp":1746488070236,"user":{"displayName":"Keithan Ducre","userId":"01311834719829791810"},"user_tz":420},"id":"Scn_S24HFl0T","outputId":"e7f940c1-b943-4dc1-b584-d60055dce693"},"outputs":[{"output_type":"stream","name":"stderr","text":["Warning message:\n","“\u001b[1m\u001b[22mRemoved 19 rows containing missing values or values outside the scale range\n","(`geom_point()`).”\n"]}],"source":["\n","# Create the combined scatter plot with Real_Visual_Angle on the x-axis and Visual_Angle on the y-axis\n","raw_plot <- ggplot(data_lon