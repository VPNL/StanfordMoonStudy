ope = perceptual_ratio_slope, intercept = perceptual_ratio_intercept, color = \"#C74632\") +  # Perceptual best fit line\n","  geom_abline(slope = perceptual_ratio_slope_lower_bound, intercept = perceptual_ratio_intercept_lower_bound, linetype = \"dotted\", color = \"#C74632\")+\n","  geom_abline(slope = perceptual_ratio_slope_upper_bound, intercept = perceptual_ratio_intercept_upper_bound, linetype = \"dotted\", color = \"#C74632\")+\n","  geom_abline(slope = adjusted_ratio_slope, intercept = adjusted_ratio_intercept, color= \"red\")+\n","  geom_abline(slope = adjusted_ratio_slope_lower_bound, intercept = adjusted_ratio_intercept_lower_bound, linetype = \"dotted\", color = \"red\")+\n","  geom_abline(slope = adjusted_ratio_slope_upper_bound, intercept = adjusted_ratio_intercept_upper_bound, linetype = \"dotted\", color = \"red\")+\n","  labs(title = \"Perceptual Magnifcation Across Different Visual Angles\",\n","       x = \"Real Visual Angle (deg)\",\n","       y = \"Reported / Real Visual Angle \") +\n","  # scale_x_continuous(breaks = c(0.5994, 1.8634, 0.7488, 1.1003),\n","  #     labels = c(\"Moon 1\", \"Moon 2\", \"Moon 3\", \"Moon 4\")) +\n","  theme_classic() +\n","  coord_fixed() +\n","  #figure out integer conversation\n","  xlim(0,15)+\n","  ylim(0,15)+\n","  scale_color_manual(values = c(\"Perceptual\" = \"#C74632\", \"Adjusted\" = \"#4298B5\"))\n","\n","\n","ggplot(perceptual_data, aes(x = Real_Visual_Angle, y = Ratio_Visual_Angle, color = Task)) +\n","  geom_point(alpha = .8, color = \"#C74632\") +\n","  geom_abline(slope = 0, intercept = 1, linetype = \"dashed\") +\n","  geom_abline(slope = perceptual_ratio_slope, intercept = perceptual_ratio_intercept, color = \"#C74632\") +  # Perceptual best fit line\n","  geom_abline(slope = perceptual_ratio_slope_lower_bound, intercept = perceptual_ratio_intercept_lower_bound, linetype = \"dotted\", color = \"#C74632\") +\n","  geom_abline(slope = perceptual_ratio_slope_upper_bound, intercept = perceptual_ratio_i